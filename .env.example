# ── Base de datos ───────────────────────────────────────────────
DATABASE_URL="postgresql://provivir:provivir@localhost:5432/provivir?schema=public&connection_limit=25"

# ── Redis / colas ───────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# ── Rate limiting ───────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Login: estricto por IP. Subirlo solo para pruebas de carga o suites e2e.
THROTTLE_LOGIN_LIMIT=5

# ── Auth (JWT) ──────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
JWT_SECRET="cambiar-en-cada-ambiente-nunca-usar-este-valor"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Sede (D1: multi-sede en el modelo, oculta en la UI) ─────────
SEDE_ID="cdc-oriente"

# ── Banderas ────────────────────────────────────────────────────
KIOSKO_ACTIVO=false

# ── WhatsApp · Meta Cloud API (Fase 4) ──────────────────────────
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WEBHOOK_VERIFY_TOKEN=""

# ── IA · Anthropic (Fase 4) ─────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Portal público (Fase 5) ─────────────────────────────────────
PORTAL_URL="http://localhost:5174"
# CAPTCHA ligero (Cloudflare Turnstile). Sin clave, el portal opera sin CAPTCHA.
TURNSTILE_SECRET=""

# ── STT · transcripción de notas de voz (RN-09.2) ───────────────
# Sin configurar, las notas de voz escalan a la asistente con el audio adjunto.
STT_URL=""
STT_API_KEY=""
STT_MODELO="whisper-1"

# ── Media de WhatsApp ───────────────────────────────────────────
# Fuera del webroot (checklist §4.10)
DIR_MEDIA="media"
