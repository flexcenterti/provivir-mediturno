{
  "info": {
    "name": "Provivir · Webhook WhatsApp",
    "description": "Simula lo que hace Meta contra el webhook de la plataforma.\n\nANTES DE EMPEZAR: define las variables `base`, `META_APP_SECRET` y `META_WEBHOOK_VERIFY_TOKEN` en la pestaña Variables de la colección (o en un Environment).\n\nLa firma HMAC se calcula sola en el pre-request script de la colección. No hay que copiar nada a mano.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Firma cada POST igual que lo hace Meta (HMAC-SHA256 del cuerpo).",
          "// El GET de verificación no lleva firma.",
          "if (pm.request.method === 'POST' && pm.request.body && pm.request.body.raw) {",
          "",
          "    // Un id único por envío. Si se repite, la plataforma lo toma como un reintento",
          "    // de Meta y lo ignora: responde 200 pero no procesa nada, y parece que funcionó.",
          "    pm.collectionVariables.set('wamid', 'wamid.postman.' + Date.now());",
          "    pm.collectionVariables.set('timestamp', Math.floor(Date.now() / 1000));",
          "",
          "    const secreto = pm.environment.get('META_APP_SECRET')",
          "        || pm.collectionVariables.get('META_APP_SECRET');",
          "",
          "    if (!secreto) {",
          "        console.warn('Falta META_APP_SECRET: la petición saldrá sin firma y dará 401.');",
          "    } else {",
          "        // CLAVE: se firma el cuerpo YA RESUELTO. Firmar la plantilla con {{variables}}",
          "        // produce una firma que nunca coincide con lo que realmente viaja.",
          "        const cuerpo = pm.variables.replaceIn(pm.request.body.raw);",
          "        const firma = CryptoJS.HmacSHA256(cuerpo, secreto).toString(CryptoJS.enc.Hex);",
          "        pm.request.headers.upsert({ key: 'x-hub-signature-256', value: 'sha256=' + firma });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:3000",
      "description": "Local: http://localhost:3000 · Servidor: https://provivir.exagos.co"
    },
    {
      "key": "META_APP_SECRET",
      "value": "secreto-local-de-pruebas-reemplazar-por-el-de-meta",
      "description": "El de la app de Meta. En local, el mismo del .env."
    },
    {
      "key": "META_WEBHOOK_VERIFY_TOKEN",
      "value": "djvnksdfj489_"
    },
    {
      "key": "telefono",
      "value": "573001234567",
      "description": "Número del paciente simulado"
    },
    {
      "key": "wamid",
      "value": "",
      "description": "Lo genera el pre-request script"
    },
    {
      "key": "timestamp",
      "value": "",
      "description": "Lo genera el pre-request script"
    }
  ],
  "item": [
    {
      "name": "1 · Verificación de registro",
      "item": [
        {
          "name": "Token correcto → devuelve el challenge",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('el cuerpo es exactamente el challenge', () => pm.response.text() === '1234567890');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/api/webhooks/whatsapp?hub.mode=subscribe&hub.verify_token={{META_WEBHOOK_VERIFY_TOKEN}}&hub.challenge=1234567890",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "webhooks",
                "whatsapp"
              ],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.verify_token",
                  "value": "{{META_WEBHOOK_VERIFY_TOKEN}}"
                },
                {
                  "key": "hub.challenge",
                  "value": "1234567890"
                }
              ]
            },
            "description": "Lo que Meta hace al dar de alta la URL. Debe devolver el challenge tal cual, sin comillas ni JSON."
          }
        },
