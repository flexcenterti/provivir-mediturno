// Esquema de datos · Grupo Provivir (CDC Oriente)
// Referencia: Arquitectura v1.0 §5 · Lógica de Negocio v2.0 (RN-01 a RN-12)
// Fase 7: RN-13 (base de conocimiento), RN-09.9 (seguimiento comercial), RN-04.5 (catálogo)
// D1: sede vive en el modelo con valor único 'cdc-oriente'; nunca se expone en la UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enumeraciones ───────────────────────────

/// RN-01, RN-04 · Tipos de cita
enum TipoCita {
  general
  control
  procedimiento
  examen
}

enum Rol {
  admin
  asistente
  prestador
  pantalla
}

/// RN-12.4 · Trazabilidad del canal que creó al paciente
enum OrigenPaciente {
  carga
  mostrador
  whatsapp
  autoagendamiento
}

enum OrigenCita {
  mostrador
  whatsapp
  autoagendamiento
  asistente
}

/// RN-06.4 · Modos de definición de disponibilidad
enum ModoAgenda {
  semanal
  calendario
}

/// RN-06.5 · Por qué la sede no atiende ese día.
enum TipoDiaNoLaborable {
  /// Festivo nacional colombiano. Se precargan calculados por año.
  festivo
  /// Cierre propio de la clínica: inventario, capacitación, mantenimiento.
  cierre
}

enum EstadoCita {
  pendiente_llegada
  confirmada
  llego
  en_atencion
  atendida
  cancelada
  no_asistio
}

enum EstadoTurno {
  en_espera
  llamado
  en_atencion
  atendido
  ausente
  /// Su cita se canceló o se movió de día estando él en sala. No es `ausente`: eso
  /// significa "se le llamó y no vino", y contarlo así ensuciaría el ausentismo con
  /// cancelaciones administrativas.
  cancelado
}

/// D6 · "prioridad", nunca "urgencia". Criterios alta/media/baja pendientes (P4);
/// mientras tanto la columna operativa dominante es el tiempo de espera (RN-05.3).
enum Prioridad {
  alta
  media
  baja
}

enum EstadoConversacion {
  ia_activa
  escalada
  en_gestion
  resuelta
}

enum DireccionMensaje {
  entrante
  saliente
}

enum TipoMensaje {
  texto
  audio
  imagen
  video
  documento
  sistema
  /// Plantilla aprobada en Meta. Se distingue del texto porque no es lo mismo ni
  /// cuesta lo mismo: es lo único que sale fuera de la ventana de 24 h.
  plantilla
}

/// RN-01.2 · Política de costo del control, parametrizable a futuro
/// RN-13.7 · Un borrador nunca se sirve al bot; archivar retira del índice sin borrar la ficha
enum EstadoArticulo {
  borrador
  publicado
  archivado
}

/// RN-13 · Desenlace de una consulta a la base de conocimiento
enum ResultadoKbConsulta {
  respondida
  escalada
  bloqueada_por_tema
}

enum EstadoKbPendiente {
  abierta
  articulo_creado
  descartada
}

/// RN-09.9.2 · Los tres pasos de la secuencia: T0+2h, T0+5h y cierre en T0+8h
enum PasoSeguimiento {
  seguimiento_1
  seguimiento_2
  cierre
}

/// RN-09.9.4 · `descartado` = quedó fuera de la ventana de 24 h de Meta y no hay plantilla
enum EstadoSeguimiento {
  programado
  enviado
  cancelado
  diferido
  descartado
}

/// RN-09.9.1 · Interés detectado en la conversación
enum InteresComercial {
  alto
  medio
  nulo
}

/// RN-09.9.9 · Desenlace comercial, para medir conversión por paso
enum ResultadoConversacion {
  agendada
  ofrecida_no_aceptada
  informativa
  escalada
  no_convertida
}

/// RN-07.6 · Cómo se resolvió el cobro en el mostrador. Solo dos desenlaces: si el
/// paciente no paga, no se registra la llegada — la ausencia de turno es la
/// constancia. Nunca añadir aquí un `pendiente_pago`: eso es un estado de la cola, y
/// se descartó a propósito.
enum CobroMostrador {
  cobrado
  exento
}

enum PoliticaCosto {
  sin_costo
  costo_pleno
  porcentaje
}

// ─────────────────────────── Sede (D1) ───────────────────────────

model Sede {
  id        String   @id
  nombre    String
  direccion String
  waNumero  String   @map("wa_numero")
  horario   String
  creadoEn  DateTime @default(now()) @map("creado_en")

  pacientes      Paciente[]
  prestadores    Prestador[]
  agendas        Agenda[]
  citas          Cita[]
  conversaciones Conversacion[]
  pantallas      Pantalla[]
  usuarios       Usuario[]
  perfiles       Perfil[]
  articulos      KbArticulo[]
  seguimientos   Seguimiento[]
  diasNoLaborables DiaNoLaborable[]
  consentimientos  ConsentimientoWhatsapp[]

  @@map("sede")
}

// ─────────────────────────── Pacientes (RN-12) ───────────────────────────

model Paciente {
  id            String         @id @default(uuid())
  tdoc          String         @default("CC")
  /// RN-12.5 · Identificador principal para deduplicación en recargas
  documento     String         @unique
  nombres       String
  apellidos     String
  telefono      String?
  whatsapp      String?
  correo        String?
  fechaNac      DateTime?      @map("fecha_nac") @db.Date
  sexo          String?
  /// Marcas preferenciales para la cola de atención (RN-05.2, RN-17)
  condiciones   String[]       @default([])
  origen        OrigenPaciente @default(carga)
  activo        Boolean        @default(true)
  /// RN-09.9.4 · Opt-out permanente de mensajería comercial (Ley 1581/2012).
  /// Se verifica en el envío, no solo al encolar.
  noContactar   Boolean        @default(false) @map("no_contactar")
  sedeId        String         @map("sede_id")
  creadoEn      DateTime       @default(now()) @map("creado_en")
  actualizadoEn DateTime       @updatedAt @map("actualizado_en")

  sede           Sede                @relation(fields: [sedeId], references: [id])
  historial      HistorialServicio[]
  citas          Cita[]
  conversaciones Conversacion[]
  seguimientos   Seguimiento[]
  consentimientos ConsentimientoWhatsapp[]

  @@index([documento])
  @@index([telefono])
  @@index([apellidos, nombres])
  @@map("paciente")
}

/// RN-12.4 · Historial OPERATIVO de servicios (últimos 10 visibles).
/// No es historia clínica: sin diagnósticos, resultados ni notas médicas.
model HistorialServicio {
  id            String   @id @default(uuid())
  pacienteId    String   @map("paciente_id")
  fecha         DateTime @db.Date
  servicioTexto String   @map("servicio_texto")

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId, fecha(sort: Desc)])
  @@map("historial_servicio")
}

// ─────────────────────────── Catálogo de servicios (RN-04) ───────────────────────────

model Servicio {
  id            String        @id
  nombre        String
  categoria     String
  tipo          TipoCita
  duracionMin   Int           @map("duracion_min")
  /// RN-04.4 · Slots que ocupa el servicio (Ecografía Doppler = 2)
  cupos         Int           @default(1)
  requiereOrden Boolean       @default(false) @map("requiere_orden")
  /// RN-01.2 · El control no tiene costo; parametrizable a futuro
  politicaCosto PoliticaCosto @default(costo_pleno) @map("politica_costo")
  /// RN-04.5.3 · Baja lógica: un servicio con citas se desactiva, nunca se elimina
  activo        Boolean       @default(true)

  // ── Ficha comercial (RN-04.5.1) · es lo que el bot usa para vender.
  // Un servicio sin descripción ni beneficios NO se ofrece por WhatsApp ni por el portal:
  // el bot no puede venderlo si no sabe qué decir de él.
  descripcionComercial String?  @map("descripcion_comercial")
  beneficios           String[] @default([])
  preparacion          String?
  enlaceInfo           String?  @map("enlace_info")
  rangoPrecio          String?  @map("rango_precio")
  /// RN-13.9 · Si es false, el bot lo describe pero no ofrece agendarlo por chat
  agendable            Boolean  @default(true)

  prestadores    PrestadorServicio[]
  agendas        Agenda[]
  citas          Cita[]
  articulos      KbArticulo[]
  seguimientos   Seguimiento[]
  conversaciones Conversacion[]

  @@map("servicio")
}

// ─────────────────────────── Prestadores (RN-01, RN-02) ───────────────────────────

model Prestador {
  id            String  @id
  nombre        String
  especialidad  String
  /// RN-02.1 · true solo para el grupo de medicina general. Único grupo que balancea.
  grupoBalanceo Boolean @default(false) @map("grupo_balanceo")
  vinculacion   String  @default("Interno")
  consultorio   String?
  activo        Boolean @default(true)
  sedeId        String  @map("sede_id")

  sede      Sede                @relation(fields: [sedeId], references: [id])
  servicios PrestadorServicio[]
  config    PrestadorConfig?
  agendas   Agenda[]
  citas     Cita[]
  usuario   Usuario?

  @@index([grupoBalanceo, activo])
  @@map("prestador")
}

/// RN-01.4 · La duración se configura por prestador Y por tipo de servicio
model PrestadorServicio {
  prestadorId String @map("prestador_id")
  servicioId  String @map("servicio_id")
  duracionMin Int    @map("duracion_min")

  prestador Prestador @relation(fields: [prestadorId], references: [id], onDelete: Cascade)
  servicio  Servicio  @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@id([prestadorId, servicioId])
  @@map("prestador_servicio")
}

model PrestadorConfig {
  prestadorId        String @id @map("prestador_id")
  /// RN-01.3 · Días máximos entre la consulta origen y el control. Referencia: 7–10, hasta 30.
  ventanaControlDias Int    @default(10) @map("ventana_control_dias")

  prestador Prestador @relation(fields: [prestadorId], references: [id], onDelete: Cascade)

  @@map("prestador_config")
}

// ─────────────────────────── Agendas (RN-06) ───────────────────────────

/// RN-06.1 · Solo administración crea/modifica/bloquea. El prestador la ve en solo lectura.
model Agenda {
  id            String     @id @default(uuid())
  prestadorId   String     @map("prestador_id")
  modo          ModoAgenda
  /// modo=semanal: días de la semana (1=lunes … 7=domingo)
  diasSemana    Int[]      @default([]) @map("dias_semana")
  /// modo=calendario: fecha puntual
  fecha         DateTime?  @db.Date
  horaIni       String     @map("hora_ini")
  horaFin       String     @map("hora_fin")
  slotMin       Int        @map("slot_min")
  servicioId    String?    @map("servicio_id")
  consultorio   String?
  activa        Boolean    @default(true)
  /// RN-06.3 · Bloqueo con citas asignadas → notificación y reprogramación
  bloqueada     Boolean    @default(false)
  motivoBloqueo String?    @map("motivo_bloqueo")
  sedeId        String     @map("sede_id")

  prestador Prestador @relation(fields: [prestadorId], references: [id], onDelete: Cascade)
  servicio  Servicio? @relation(fields: [servicioId], references: [id])
  sede      Sede      @relation(fields: [sedeId], references: [id])

  @@index([prestadorId, activa])
  @@index([fecha])
  @@map("agenda")
}

/// RN-06.5 · Día en que la sede no atiende: ningún canal ofrece ni agenda cupos.
///
/// No se resuelve con `Agenda.bloqueada` porque ese campo no tiene fecha: bloquear
/// una agenda semanal la apagaría todos los lunes, no un lunes concreto.
model DiaNoLaborable {
  id       String             @id @default(uuid())
  fecha    DateTime           @db.Date
  motivo   String
  tipo     TipoDiaNoLaborable @default(festivo)
  sedeId   String             @map("sede_id")
  creadoEn DateTime           @default(now()) @map("creado_en")

  sede Sede @relation(fields: [sedeId], references: [id])

  @@unique([sedeId, fecha])
  @@index([fecha])
  @@map("dia_no_laborable")
}

// ─────────────────────────── Citas · el núcleo (RN-01 a RN-04) ───────────────────────────

model Cita {
  id            String     @id @default(uuid())
  /// Código de atención, único por sede y día
  codigo        String
  pacienteId    String     @map("paciente_id")
  prestadorId   String     @map("prestador_id")
  servicioId    String     @map("servicio_id")
  tipo          TipoCita
  /// RN-01.3 · Un control exige su consulta origen y debe caer dentro de la ventana del prestador
  citaOrigenId  String?    @map("cita_origen_id")
  fecha         DateTime   @db.Date
  /// Hora de inicio en minutos desde medianoche — aritmética de solapamiento sin ambigüedad de zona horaria
  horaInicio    Int        @map("hora_inicio")
  duracionMin   Int        @map("duracion_min")
  estado        EstadoCita @default(confirmada)
  origen        OrigenCita
  observacion   String?
  /// Por qué se canceló. Campo propio porque antes el motivo pisaba `observacion` y
  /// se llevaba por delante lo que hubiera anotado quien agendó.
  motivoCancelacion String? @map("motivo_cancelacion")
  sedeId        String     @map("sede_id")
  creadoEn      DateTime   @default(now()) @map("creado_en")
  actualizadoEn DateTime   @updatedAt @map("actualizado_en")

  paciente   Paciente  @relation(fields: [pacienteId], references: [id])
  prestador  Prestador @relation(fields: [prestadorId], references: [id])
  servicio   Servicio  @relation(fields: [servicioId], references: [id])
  sede       Sede      @relation(fields: [sedeId], references: [id])
  citaOrigen Cita?     @relation("ControlDeConsulta", fields: [citaOrigenId], references: [id])
  controles  Cita[]    @relation("ControlDeConsulta")
  turno      Turno?

  /// Invariante: el código no se repite dentro del mismo día en la misma sede
  @@unique([sedeId, fecha, codigo])
  /// Índice del motor: la consulta más caliente es "citas de este prestador ese día"
  @@index([fecha, prestadorId, horaInicio])
  @@index([codigo])
  @@map("cita")
}

// ─────────────────────────── Turnos · cola en sede (RN-05, RN-07) ───────────────────────────

model Turno {
  id               String      @id @default(uuid())
  citaId           String      @unique @map("cita_id")
  llegadaTs        DateTime    @default(now()) @map("llegada_ts")
  estado           EstadoTurno @default(en_espera)
  prioridad        Prioridad   @default(baja)
  /// RN-07.4 · Si el prestador prioriza, la nota del motivo es obligatoria y queda auditada
  notaPriorizacion String?     @map("nota_priorizacion")
  priorizadoPor    String?     @map("priorizado_por")
  llamadoTs        DateTime?   @map("llamado_ts")
  consultorio      String?

  /// RN-07.6 · Constancia de qué se hizo con el cobro. Sin importes: la plataforma
  /// registra la decisión, no el dinero.
  ///
  /// `null` significa **no consta**, NO «no se cobró»: son las llegadas anteriores a
  /// la regla, y será también el kiosko, que registra la llegada antes de que el
  /// paciente pase por caja. Poner `cobrado` en esas filas sería inventar un hecho
  /// sobre dinero.
  cobro       CobroMostrador?
  /// Obligatoria cuando el desenlace contradice la política del servicio (RN-07.6).
  cobroNota   String?         @map("cobro_nota")
  /// Quién lo resolvió. No basta la auditoría: ese servicio traga sus propios fallos
  /// a propósito, y un registro con pérdidas no puede ser el único de algo contiguo
  /// al dinero. Mismo motivo que `priorizadoPor`.
  cobradoPor  String?         @map("cobrado_por")
  /// Separado de `llegadaTs` porque hoy coinciden y con el kiosko no lo harán.
  cobroTs     DateTime?       @map("cobro_ts")

  cita Cita @relation(fields: [citaId], references: [id], onDelete: Cascade)

  /// Orden de la cola: prioridad primero, luego llegada (RN-07.3)
  @@index([estado, prioridad, llegadaTs])
  @@map("turno")
}

// ─────────────────────────── Conversaciones WhatsApp (RN-08, RN-09) ───────────────────────────

model Conversacion {
  id         String             @id @default(uuid())
  pacienteId String?            @map("paciente_id")
  telefono   String
  estado     EstadoConversacion @default(ia_activa)
  intencion  String?
  confianza  Int?
  escalada   Boolean            @default(false)
  /// RN-08.3 · Marca temporal del escalamiento: alimenta la columna "tiempo esperando"
  escaladaTs DateTime?          @map("escalada_ts")
  motivo     String?
  prioridad  Prioridad          @default(baja)
  tomadaPor  String?            @map("tomada_por")
  resueltaTs DateTime?          @map("resuelta_ts")
  /// Cuándo se reabrió una conversación ya cerrada. Es el reloj operativo de la
  /// bandeja: "esperando" se cuenta desde aquí, no desde el escalamiento original.
  ///
  /// Existe como campo propio, en vez de pisar `escalada`/`escaladaTs`, porque las
  /// métricas se calculan sobre el estado ACTUAL y no sobre una foto: reutilizarlos
  /// inflaría las escalaciones de un mes ya reportado.
  reabiertaTs DateTime?         @map("reabierta_ts")
  reaperturas Int               @default(0)
  sedeId     String             @map("sede_id")
  creadoEn   DateTime           @default(now()) @map("creado_en")

  // ── Interés comercial (RN-09.9.1) · dispara la secuencia de seguimiento
  interesComercial  InteresComercial       @default(nulo) @map("interes_comercial")
  interesServicioId String?                @map("interes_servicio_id")
  /// El bot ya ofreció la cita. Sin esto no se arma seguimiento: no se persigue a quien nunca recibió oferta.
  ctaOfrecido       Boolean                @default(false) @map("cta_ofrecido")
  resultado         ResultadoConversacion?

  paciente        Paciente?     @relation(fields: [pacienteId], references: [id])
  sede            Sede          @relation(fields: [sedeId], references: [id])
  interesServicio Servicio?     @relation(fields: [interesServicioId], references: [id])
  /// Quién la está atendiendo. La relación existe para poder mostrar su NOMBRE: con
  /// un id suelto la bandeja solo podía decir "En gestión", y ni el aviso de
  /// conflicto podía nombrar a quien ya la tenía.
  asistente       Usuario?      @relation(fields: [tomadaPor], references: [id])
  mensajes        Mensaje[]
  seguimientos    Seguimiento[]
  consultasKb     KbConsulta[]

  /// Consulta de la bandeja: pendientes = escalada && sin resolver
  @@index([escalada, resueltaTs])
  @@index([telefono])
  /// Histórico de la bandeja: las cerradas se listan por fecha de cierre.
  @@index([resueltaTs])
  @@map("conversacion")
}

/// RN-09.10 · Autorización de tratamiento de datos personales (Ley 1581 de 2012)
/// dada por WhatsApp, antes de atender nada.
///
/// NO cuelga del paciente a propósito: en el primer mensaje no se sabe quién escribe
/// —`Conversacion.pacienteId` es nulo justo por eso— y el consentimiento hay que
/// pedirlo antes de tratar ningún dato. La llave es el identificador que entrega Meta,
/// que puede ser un teléfono E.164 o un `wa:CO.<id>` cuando la persona usa nombre de
/// usuario; para esto da igual cuál sea, porque es estable por interlocutor.
model ConsentimientoWhatsapp {
  id String @id @default(uuid())

  /// El `wa_id` tal cual llega de Meta. Es la llave que existe desde el primer mensaje.
  identificador String @unique

  /// Estado actual. Un rechazo se registra pero NO cierra el canal: si la persona
  /// vuelve a escribir se le pregunta otra vez.
  aceptado Boolean

  ts DateTime @default(now())

  /// QUÉ aceptó exactamente. Sin esto no se puede probar un consentimiento el día que
  /// la política cambie de contenido.
  politicaUrl String @map("politica_url")

  /// Se enlaza cuando la persona confirma su documento, no antes.
  pacienteId String? @map("paciente_id")
  sedeId     String  @map("sede_id")

  paciente Paciente? @relation(fields: [pacienteId], references: [id])
  sede     Sede      @relation(fields: [sedeId], references: [id])

  @@index([pacienteId])
  @@map("consentimiento_whatsapp")
}

model Mensaje {
  id             String           @id @default(uuid())
  conversacionId String           @map("conversacion_id")
  direccion      DireccionMensaje
  tipo           TipoMensaje      @default(texto)
  contenido      String?
  /// Media fuera del webroot; se sirve con URL firmada y expiración
  mediaPath      String?          @map("media_path")
  transcripcion  String?
  /// ID del mensaje en Meta, para conciliar acuses de entrega
  waMessageId    String?          @unique @map("wa_message_id")
  ts             DateTime         @default(now())

  /// RN-13.7.3 · Qué artículos sustentaron esta respuesta y con qué puntaje.
  /// Cuando el bot responde mal se corrige el artículo culpable, no el prompt.
  kbArticulosUsados String[] @default([]) @map("kb_articulos_usados")
  kbScore           Int?     @map("kb_score")

  /// Quién escribió un mensaje saliente. Nulo = no lo escribió una persona: el bot,
  /// un recordatorio o una secuencia de seguimiento. Sin esto, en el chat no había
  /// forma de distinguir al bot de una asistente, ni a una asistente de otra.
  ///
  /// Los mensajes anteriores a este campo se quedan sin autor: no hay de dónde
  /// reconstruirlo, y atribuirlos a alguien sería inventárselo.
  autorId String? @map("autor_id")

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autor        Usuario?     @relation(fields: [autorId], references: [id])
  consultaKb   KbConsulta?

  @@index([conversacionId, ts])
  @@map("mensaje")
}

// ─────────────────────────── Pantallas de sala (RN-11) ───────────────────────────

model Pantalla {
  id                        String   @id @default(uuid())
  nombre                    String
  /// RN-11.1 · Configuración por sala/servicio, no por pisos
  servicios                 String[] @default([])
  turnosVisibles            Int      @default(4) @map("turnos_visibles")
  sonido                    Boolean  @default(true)
  mensaje                   String?
  /// RN-11.2 · Frame multimedia: canal en vivo + videos institucionales rotando
  media                     Boolean  @default(false)
  canalYoutube              String?  @map("canal_youtube")
  videosPromo               String[] @default([]) @map("videos_promo")
  intervaloInstitucionalMin Int      @default(10) @map("intervalo_institucional_min")
  sedeId                    String   @map("sede_id")

  sede Sede @relation(fields: [sedeId], references: [id])

  @@map("pantalla")
}

// ─────────────────────────── Usuarios y auditoría ───────────────────────────

/**
 * Perfil de acceso · qué puede ver y hacer quien lo tenga.
 * Sustituye al enum de cuatro roles: una clínica real tiene matices que no caben
 * en cuatro cajas, y cada matiz obligaba a tocar código. Los permisos válidos son
 * la lista cerrada de packages/shared/src/permisos.ts.
 */
model Perfil {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  /// Claves de packages/shared · PERMISOS
  permisos    String[] @default([])
  /// Los perfiles base no se pueden borrar, pero sí editar.
  sistema     Boolean  @default(false)
  activo      Boolean  @default(true)
  sedeId      String   @map("sede_id")
  creadoEn    DateTime @default(now()) @map("creado_en")

  sede     Sede      @relation(fields: [sedeId], references: [id])
  usuarios Usuario[]

  @@map("perfil")
}

model Usuario {
  id           String    @id @default(uuid())
  nombre       String
  email        String    @unique
  hashPassword String    @map("hash_password")
  /// Se conserva para el vínculo con la ficha del prestador y las pantallas.
  /// La autorización la decide el perfil, no esto.
  rol          Rol
  /// De dónde salen los permisos. Nulo solo durante la migración.
  perfilId     String?   @map("perfil_id")
  /// Un usuario con rol=prestador se ata a su ficha de prestador (RN-06.2)
  prestadorId  String?   @unique @map("prestador_id")
  activo       Boolean   @default(true)
  ultimoAcceso DateTime? @map("ultimo_acceso")
  sedeId       String    @map("sede_id")
  creadoEn     DateTime  @default(now()) @map("creado_en")

  prestador Prestador? @relation(fields: [prestadorId], references: [id])
  sede      Sede       @relation(fields: [sedeId], references: [id])
  perfil    Perfil?    @relation(fields: [perfilId], references: [id])

  conversaciones Conversacion[]
  mensajes       Mensaje[]

  @@index([perfilId])
  @@map("usuario")
}

/// Append-only. Nunca se actualiza ni se borra: sin @updatedAt a propósito.
model Auditoria {
  id         String   @id @default(uuid())
  ts         DateTime @default(now())
  usuario    String
  accion     String
  entidad    String
  detalle    String?
  estadoPrev String?  @map("estado_prev")
  estadoNext String?  @map("estado_next")

  @@index([ts(sort: Desc)])
  @@index([entidad])
  @@map("auditoria")
}

/// RN-09.5 · Agenda de contactos del celular del cliente (50.000+), cargada antes de
/// migrar el número a la API. NO son pacientes: es solo el directorio que permite
/// saludar por su nombre a quien escribe sin estar registrado.
model Contacto {
  id       String   @id @default(uuid())
  /// Normalizado a E.164 para poder cruzarlo con el número que entrega WhatsApp.
  telefono String   @unique
  nombre   String
  origen   String   @default("agenda-celular")
  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([nombre])
  @@map("contacto")
}

/// Parámetros de reglas fuera del código (Arquitectura §9):
/// hueco_max, ventanas, umbrales de IA, KIOSKO_ACTIVO, intervalo institucional.
model Configuracion {
  clave         String   @id
  valor         String
  descripcion   String?
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion")
}

// ───────────────── Base de conocimiento del bot (RN-13) ─────────────────
// Reemplaza a `configuracion.documentacion_comercial`, que hoy inyecta la
// documentación entera en el prompt de todas las conversaciones.
// Recuperación léxica sin pgvector: ver docs/adr-a8-recuperacion-conocimiento.md.

/// RN-13 · Contenido institucional aprobado. NUNCA datos de pacientes (RN-13.8):
/// el índice se comparte entre todas las conversaciones.
model KbArticulo {
  id          String         @id @default(uuid())
  titulo      String
  categoria   String
  contenidoMd String         @map("contenido_md")
  /// Vincula el artículo a un servicio del catálogo. Las CIFRAS salen del servicio,
  /// nunca del texto del artículo (RN-13.1).
  servicioId  String?        @map("servicio_id")
  tags        String[]       @default([])
  estado      EstadoArticulo @default(borrador)
  version     Int            @default(1)

  vigenteDesde     DateTime  @default(now()) @map("vigente_desde")
  /// RN-13.5.5 · Cumplida la fecha, un trabajo diario archiva el artículo solo
  vigenteHasta     DateTime? @map("vigente_hasta")
  /// RN-13.5 · Se conserva archivado: la auditoría debe poder explicar respuestas ya dadas
  archivadoEn      DateTime? @map("archivado_en")
  archivadoPor     String?   @map("archivado_por")
  /// RN-04.5.4 · Su servicio se desactivó; hay que revisar si el artículo sigue aplicando
  requiereRevision Boolean   @default(false) @map("requiere_revision")

  autorId       String?  @map("autor_id")
  sedeId        String   @map("sede_id")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  servicio   Servicio?     @relation(fields: [servicioId], references: [id])
  sede       Sede          @relation(fields: [sedeId], references: [id])
  fragmentos KbFragmento[]

  /// La consulta de recuperación filtra siempre por estado publicado
  @@index([estado, servicioId])
  @@index([requiereRevision])
  @@map("kb_articulo")
}

/// RN-13 · Trozos indexables del artículo. Archivar el artículo los borra en la MISMA
/// transacción: no existe un estado en el que esté archivado pero aún sea recuperable.
model KbFragmento {
  id         String @id @default(uuid())
  articuloId String @map("articulo_id")
  orden      Int
  texto      String
  tokens     Int    @default(0)

  /// Índice léxico: to_tsvector('spanish', inmutable_unaccent(texto)).
  /// Lo mantiene un trigger definido en la migración —Prisma no modela tsvector—,
  /// así que no puede quedar desincronizado del texto. No se lee desde Prisma Client:
  /// la búsqueda va por SQL crudo.
  tsv Unsupported("tsvector")?

  articulo KbArticulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)

  @@unique([articuloId, orden])
  /// Capa léxica de la recuperación (RN-13, ADR A8)
  @@index([tsv], type: Gin)
  /// Tolerancia a errores de tipeo y a nombres propios de exámenes ("Doppler", "TSH")
  @@index([texto(ops: raw("gin_trgm_ops"))], type: Gin, map: "kb_fragmento_texto_trgm_idx")
  @@map("kb_fragmento")
}

/// RN-13.7.3 · Cada consulta del bot, con lo que recuperó y en qué terminó
model KbConsulta {
  id             String              @id @default(uuid())
  conversacionId String?             @map("conversacion_id")
  /// Un mensaje del bot se sustenta como máximo en una consulta
  mensajeId      String?             @unique @map("mensaje_id")
  pregunta       String
  scoreTop       Int?                @map("score_top")
  articulos      String[]            @default([])
  resultado      ResultadoKbConsulta
  /// Presente cuando resultado = bloqueada_por_tema (RN-13.4)
  temaBloqueado  String?             @map("tema_bloqueado")
  ts             DateTime            @default(now())

  conversacion Conversacion? @relation(fields: [conversacionId], references: [id], onDelete: SetNull)
  mensaje      Mensaje?      @relation(fields: [mensajeId], references: [id], onDelete: SetNull)

  @@index([resultado, ts])
  @@map("kb_consulta")
}

/// RN-13.6 · Preguntas que escalaron por falta de cobertura, agrupadas por similitud.
/// Convertirlas en artículos es el mecanismo concreto de la mejora de RN-08.4.
model KbPendiente {
  id                    String            @id @default(uuid())
  preguntaNormalizada   String            @unique @map("pregunta_normalizada")
  preguntaEjemplo       String            @map("pregunta_ejemplo")
  /// Repetir la pregunta incrementa el contador; no crea otra fila
  ocurrencias           Int               @default(1)
  ejemploConversacionId String?           @map("ejemplo_conversacion_id")
  estado                EstadoKbPendiente @default(abierta)
  creadoEn              DateTime          @default(now()) @map("creado_en")
  actualizadoEn         DateTime          @updatedAt @map("actualizado_en")

  /// La bandeja las ordena por frecuencia
  @@index([estado, ocurrencias])
  /// RN-13.6 · agrupar preguntas sin respuesta por similitud
  @@index([preguntaNormalizada(ops: raw("gin_trgm_ops"))], type: Gin, map: "kb_pendiente_pregunta_trgm_idx")
  @@map("kb_pendiente")
}

// ────────────── Seguimiento comercial (RN-09.9) ──────────────
// Extiende el seguimiento de RN-09.8, que ya verifica que no exista cita antes
// de escribir. Aquí se persiste el estado de la secuencia de tres pasos.

/// RN-09.9 · Un envío programado de la secuencia. La cola de BullMQ es la que
/// dispara; esta tabla es la que permite ver el estado en la bandeja y hacer
/// cumplir los límites de insistencia con restricciones de base de datos (RN-09.9.7).
model Seguimiento {
  id             String            @id @default(uuid())
  conversacionId String            @map("conversacion_id")
  pacienteId     String?           @map("paciente_id")
  /// Cuando no hay paciente registrado, el teléfono es la única identidad disponible
  telefono       String
  servicioId     String            @map("servicio_id")
  paso           PasoSeguimiento
  estado         EstadoSeguimiento @default(programado)

  programadoPara    DateTime  @map("programado_para")
  enviadoEn         DateTime? @map("enviado_en")
  /// RN-09.9.4 · Por qué no salió: respondió, agendó, opt-out, servicio desactivado,
  /// fuera de la ventana de 24 h de Meta…
  motivoCancelacion String?   @map("motivo_cancelacion")

  sedeId   String   @map("sede_id")
  creadoEn DateTime @default(now()) @map("creado_en")

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  paciente     Paciente?    @relation(fields: [pacienteId], references: [id])
  servicio     Servicio     @relation(fields: [servicioId], references: [id])
  sede         Sede         @relation(fields: [sedeId], references: [id])

  /// Rearmar la secuencia no puede duplicar envíos
  @@unique([conversacionId, paso])
  /// El worker busca lo que toca enviar
  @@index([estado, programadoPara])
  /// RN-09.9.7.2 · Una sola secuencia por paciente y servicio cada 30 días
  @@index([telefono, servicioId, creadoEn])
  @@map("seguimiento")
}
