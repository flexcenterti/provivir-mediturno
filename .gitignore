# Dependencias
node_modules/

# Build
dist/
dist-esm/
build/
*.tsbuildinfo
# Frontends compilados que el instalador coloca para Caddy
despliegue/web/

# Secretos — nunca al repo
.env
.env.*
!.env.example

# Configuración local de Claude Code (permisos/ajustes de esta máquina)
.claude/settings.local.json

# Documentación de desarrollo (planeación interna, no normativa)
docs/*.xls
docs/*.xlsx

# Prisma
apps/api/prisma/*.db
apps/api/prisma/migrations/dev.db*

# Datos de carga masiva (PII de pacientes)
uploads/
# Adjuntos de WhatsApp y anuncios de sala: se generan en ejecución y en las pruebas.
# Faltaba, y una corrida de la suite llegó a commitear 112 PNG de usar y tirar.
media/
*.csv
!docs/**/*.csv

# Runtime local
.pgdata/
.redisdata/

# Salida de las pruebas de navegador
test-results/
playwright-report/
e2e/capturas/

# Respaldos de la base: NUNCA en el repositorio.
# Un volcado cifrado de ~200.000 pacientes no va en git, y si entra queda en el
# historial para siempre. El checklist además los quiere fuera del servidor.
respaldos/
*.dump.gz.enc

# SO / Editor
.DS_Store
.vscode/
.idea/

# Logs y temporales
*.log
coverage/
tmp/
