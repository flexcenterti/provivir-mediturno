# Caddy · TLS automático (Let's Encrypt) y cabeceras de seguridad.
#
# DOMINIO ÚNICO con enrutamiento por ruta. El dominio sale de una variable de
# entorno para que migrar al definitivo sea un cambio en /etc/provivir/.env y un
# reinicio, no una edición de este archivo:
#
#   DOMINIO=provivir.exagos.co          (temporal)
#   DOMINIO=agenda.grupoprovivir.com    (definitivo)
#
#   /                        → backoffice (privado, tras login)
#   /citas                   → portal público de autoagendamiento
#   /tv                      → pantallas de sala (solo red interna)
#   /api                     → API
#   /api/webhooks/whatsapp   → webhook de Meta
#   /tiempo-real             → WebSocket de llamados
#
# Si el dominio definitivo permite subdominios, `Caddyfile.subdominios.ejemplo`
# tiene la variante con un host por aplicación, que aísla mejor las cabeceras.

{$DOMINIO:provivir.exagos.co} {
	root * /srv

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Caddy ya se anuncia; no hace falta regalar la versión del servidor.
		-Server
	}

	# ── API y tiempo real ──
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /tiempo-real/* {
		reverse_proxy api:3000
	}

	# ── Portal público ──
	# Se embebe por iframe en el sitio del cliente: es la única app que lo permite.
	handle /citas* {
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; frame-ancestors 'self' https://grupoprovivir.com https://www.grupoprovivir.com"
		}
		try_files {path} /citas/index.html
		file_server
	}

	# ── Pantallas de sala ──
	#
	# Accesibles desde cualquier red, por decisión del cliente: los televisores se
	# instalan y reinstalan sin que haya un técnico de redes cerca, y atarlos a un
	# rango de IP convertía cada cambio de router en una incidencia.
	#
	# Lo que las protege es que la URL lleva el id de la pantalla (un UUID), y ese
	# id solo se ve desde el backoffice, que sí exige sesión. Es una defensa por
	# secreto: quien tenga el enlace entra, y el enlace no caduca. Si alguno se
	# filtra, se corta creando una pantalla nueva y retirando la anterior.
	#
	# Por eso importa lo que se muestra: ver `mostrar_nombre_en_pantalla` en la
	# configuración, que decide si el paciente aparece con nombre completo.
	handle /tv* {
		header {
			# La TV embebe el frame de YouTube.
			Content-Security-Policy "default-src 'self'; img-src 'self' data: https://i.ytimg.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://www.youtube.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self'"
			X-Frame-Options "SAMEORIGIN"
			# No se indexa: una pantalla en un buscador anularía el único control.
			X-Robots-Tag "noindex, nofollow, noarchive"
		}
		try_files {path} /tv/index.html
		file_server
	}

	# ── Backoffice ──
	# Nunca embebible: es la consola con datos de pacientes.
	handle {
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' wss://{$DOMINIO:provivir.exagos.co}; frame-ancestors 'none'"
			X-Frame-Options "DENY"
		}
		try_files {path} /index.html
		file_server
	}
}
